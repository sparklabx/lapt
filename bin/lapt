#!/usr/bin/env bash
set -u
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
. "$ROOT/lib/apt.sh"
. "$ROOT/lib/bundle.sh"
. "$ROOT/lib/expose.sh"
. "$ROOT/lib/wrap.sh"
. "$ROOT/lib/state.sh"
. "$ROOT/lib/cache.sh"

lapt::die() { echo "lapt: $*" >&2; exit 1; }
lapt::warn() { echo "lapt: $*" >&2; }

usage() {
  cat <<'EOF'
usage: lapt <command> [args]
       lapt --help          show this help text

commands:
  install <pkg...>   install package(s)
  remove <pkg...>    uninstall package(s)
  list [pkg...]      list installed packages
  vendor <pkg...>    use installed package(s) as build dependency
  expose <pkg>       make an installed package available (binary, man page, etc.)
  fix <pkg>          repair a package's system dependencies
  rewrap <pkg>       refresh an installed package's wrapper (e.g. after editing pkgenv/<pkg>)
  prune              prune cache files
  init               set up shell integration ($LAPT_HOME/env)
EOF
}

LAPT_HOME="$HOME/.lapt"

_install_one() {
  local pkg=$1
  local opt_dir="$LAPT_HOME/opt/$pkg"

  if [[ -d $opt_dir ]]; then
    echo "lapt: $pkg is already installed — run 'lapt remove $pkg' first"
    return 0
  fi

  if dpkg -s "$pkg" >/dev/null 2>&1; then
    echo "lapt: $pkg is already installed via the system package manager"
    return 0
  fi

  local version
  version=$(apt-cache policy "$pkg" | sed -n 's/^  Candidate: //p')
  [[ -n $version ]] || { lapt::warn "no apt candidate found for $pkg"; return 1; }

  lapt::cache_ensure "$pkg" "$version" || { lapt::warn "failed to fetch $pkg=$version"; return 1; }
  local cache_path; cache_path=$(lapt::cache_entry_path "$pkg" "$version")

  local closure
  closure=$(apt-cache depends --recurse --no-recommends --no-suggests --no-conflicts \
    --no-breaks --no-replaces --no-enhances "$pkg" | lapt::resolve_closure)

  local -a specs=("$pkg"$'\t'"$version"$'\t'"$pkg")
  local system_deps=""
  local group sat
  while IFS= read -r group; do
    [[ -z $group ]] && continue
    if sat=$(lapt::is_system_satisfied "$group"); then
      system_deps+="$sat"$'\n'
      continue
    fi
    local pick name dep_version
    pick=$(lapt::pick_candidate "$group") || { lapt::warn "no apt candidate for $group"; return 1; }
    read -r name dep_version <<<"$pick"
    lapt::cache_ensure "$name" "$dep_version" || { lapt::warn "failed to fetch $name=$dep_version"; return 1; }
    specs+=("$name"$'\t'"$dep_version"$'\t'"$name")
  done <<<"$closure"

  # Assemble into a scratch dir first, sibling of opt_dir on the same
  # filesystem, and only mv it into place once everything below succeeds --
  # otherwise a failure partway through would leave opt_dir existing-but-
  # incomplete, and the already-installed check above would treat that as a
  # permanently "done" install with no way to retry. Same atomic-mv pattern
  # lapt::cache_ensure already uses for cache entries.
  mkdir -p "$LAPT_HOME/opt"
  local work_dir; work_dir=$(mktemp -d "$LAPT_HOME/opt/.tmp.XXXXXX")

  local manifest
  manifest=$(lapt::bundle_manifest "$work_dir" "${specs[@]}") || { rm -rf "$work_dir"; lapt::warn "bundle failed for $pkg"; return 1; }
  lapt::bundle_apply "$work_dir" 1 "$opt_dir" <<<"$manifest"

  local wrapper_kind; wrapper_kind=$(printf '%s\n' "$manifest" | lapt::needs_wrapper "$pkg")
  if [[ -n $wrapper_kind ]]; then
    local lib_dir="" bin_dir=""
    [[ $wrapper_kind == *lib* ]] && lib_dir=$(lapt::lib_dir_list "$work_dir/lib" "$opt_dir/lib" "$pkg")
    [[ $wrapper_kind == *bin* ]] && bin_dir="$opt_dir/bin"
    # work_dir is where the files physically live right now; opt_dir is the
    # final path they'll run from once the mv below lands, so the wrapper's
    # baked-in exec target must point there, not at work_dir.
    printf '%s\n' "$manifest" | lapt::wrap_top_level_bins "$work_dir" "$opt_dir" "$pkg" "$lib_dir" "$bin_dir"
  fi

  lapt::version_write "$work_dir" "$version"
  printf '%s' "$system_deps" | lapt::system_deps_write "$work_dir"

  mv "$work_dir" "$opt_dir"

  # Exposure runs after the mv, once opt_dir is the real final path -- no
  # need to bake in a not-yet-existing target, and a collision here doesn't
  # need to unwind the install: opt_dir is already a complete, valid,
  # removable package, just not fully exposed to $PATH/man yet.
  printf '%s\n' "$manifest" | lapt::expose_add "$pkg" > "$opt_dir/.lapt/exposed" \
    || echo "lapt: $pkg installed at $opt_dir, but some files could not be exposed (see warnings above) -- run 'lapt expose $pkg' to retry"

  # bin/lib/share are the only categories exposure/wrap.sh do anything with;
  # note any other top-level dir (etc, sbin, ...) so it isn't a silent no-op.
  local -A unhandled=()
  local rel _src _origin dir
  while IFS=$'\t' read -r rel _src _origin; do
    dir=${rel%%/*}
    case $dir in bin|lib|share) ;; *) unhandled[$dir]=1 ;; esac
  done <<<"$manifest"
  for dir in "${!unhandled[@]}"; do
    echo "lapt: $pkg also has $dir/ under $opt_dir -- bundled but not exposed"
  done

  return 0
}

cmd_install() {
  (( $# > 0 )) || lapt::die "usage: lapt install <pkg...>"
  local -a failed=()
  local pkg
  for pkg in "$@"; do
    _install_one "$pkg" || failed+=("$pkg")
  done
  (( ${#failed[@]} == 0 )) || lapt::die "install failed for: ${failed[*]}"
  return 0
}

cmd_expose() {
  local pkg=$1
  local opt_dir="$LAPT_HOME/opt/$pkg"
  [[ -f "$opt_dir/.lapt/version" ]] || lapt::die "$pkg is not installed"

  local version
  version=$(sed -n 's/^version=//p' "$opt_dir/.lapt/version")

  # Only pkg's own cache entry matters here: expose_add only ever exposes
  # rows whose origin is the top-level pkg itself, never a dependency's, so
  # the dependency closure doesn't need to be re-resolved to redo exposure.
  local manifest
  manifest=$(lapt::bundle_manifest "$(mktemp -u -d)" "$pkg"$'\t'"$version"$'\t'"$pkg") \
    || lapt::die "failed to compute what to expose for $pkg"

  printf '%s\n' "$manifest" | lapt::expose_add "$pkg" > "$opt_dir/.lapt/exposed" \
    || echo "lapt: $pkg still has files that could not be exposed (see warnings above) -- fix the collisions and run 'lapt expose $pkg' again"
  return 0
}

_remove_one() {
  local pkg=$1
  local opt_dir="$LAPT_HOME/opt/$pkg"
  [[ -f "$opt_dir/.lapt/version" ]] || { lapt::warn "$pkg is not installed"; return 1; }

  lapt::expose_remove "$pkg" < "$opt_dir/.lapt/exposed"
  rm -rf "$opt_dir"
  echo "lapt: removed $pkg"
  return 0
}

cmd_remove() {
  (( $# > 0 )) || lapt::die "usage: lapt remove <pkg...>"
  local -a failed=()
  local pkg
  for pkg in "$@"; do
    _remove_one "$pkg" || failed+=("$pkg")
  done
  (( ${#failed[@]} == 0 )) || lapt::die "remove failed for: ${failed[*]}"
  return 0
}

cmd_list() {
  local -A want=()
  local pkg
  for pkg in "$@"; do want[$pkg]=1; done

  local opt_dir
  for opt_dir in "$LAPT_HOME/opt"/*/; do
    [[ -f "$opt_dir/.lapt/version" ]] || continue
    pkg=$(basename "$opt_dir")
    (( $# == 0 )) || [[ -n ${want[$pkg]+x} ]] || continue
    local version
    version=$(sed -n 's/^version=//p' "$opt_dir/.lapt/version")
    printf '%s %s\n' "$pkg" "$(sed -E 's/\+deb[0-9]+u[0-9]+$//' <<<"$version")"
  done
  return 0
}

cmd_fix() {
  local pkg=$1
  local opt_dir="$LAPT_HOME/opt/$pkg"
  [[ -f "$opt_dir/.lapt/version" ]] || lapt::die "$pkg is not installed"

  local version
  version=$(sed -n 's/^version=//p' "$opt_dir/.lapt/version")

  local -a specs=() still_satisfied=()
  local name dep_version
  while read -r name dep_version; do
    [[ -z $name ]] && continue
    if dpkg -s "$name" >/dev/null 2>&1; then
      still_satisfied+=("$name $dep_version")
    else
      lapt::cache_ensure "$name" "$dep_version" || lapt::die "failed to fetch $name=$dep_version"
      specs+=("$name"$'\t'"$dep_version"$'\t'"$name")
    fi
  done < "$opt_dir/.lapt/system-deps"

  if (( ${#specs[@]} > 0 )); then
    local manifest
    manifest=$(lapt::bundle_manifest "$opt_dir" "${specs[@]}") || lapt::die "bundle failed while fixing $pkg"
    lapt::bundle_apply "$opt_dir" 0 <<<"$manifest"

    # bundle_manifest's existing-scan of the real opt_dir tags every
    # already-present file's origin as the literal string "existing" --
    # it can't tell "pkg's own file" from "a dependency's file" once
    # they're sitting on disk together. needs_wrapper/wrap_top_level_bins
    # both key off origin == pkg to find pkg's own bin/ files, so recover
    # that from the one place that still knows: pkg's own cache entry
    # (same trick cmd_expose uses to recompute what's pkg's own).
    local own_manifest
    own_manifest=$(lapt::bundle_manifest "$(mktemp -u -d)" "$pkg"$'\t'"$version"$'\t'"$pkg")

    local -A own_bin=()
    local rel src origin
    while IFS=$'\t' read -r rel src origin; do
      [[ $rel == bin/* ]] && own_bin[$rel]=1
    done <<<"$own_manifest"

    # Already wrapped if any of pkg's own bin/ files already has a .real
    # sibling -- wrap_top_level_bins unconditionally mv's bin/<name> to
    # bin/<name>.real, so calling it again on an already-wrapped package
    # would clobber the real binary with the wrapper script itself. Only
    # regenerate a wrapper the first time it becomes necessary (a package
    # that was entirely system-satisfied has no wrapper at all until now,
    # per ADR-0007).
    local already_wrapped=0
    for rel in "${!own_bin[@]}"; do
      [[ -e "$opt_dir/$rel.real" ]] && already_wrapped=1
    done

    if (( ! already_wrapped )); then
      local wrap_manifest=""
      while IFS=$'\t' read -r rel src origin; do
        [[ $origin == existing && -n ${own_bin[$rel]+x} ]] && origin=$pkg
        wrap_manifest+="$rel"$'\t'"$src"$'\t'"$origin"$'\n'
      done <<<"$manifest"

      local after_kind
      after_kind=$(printf '%s' "$wrap_manifest" | lapt::needs_wrapper "$pkg")
      if [[ -n $after_kind ]]; then
        local lib_dir="" bin_dir=""
        [[ $after_kind == *lib* ]] && lib_dir=$(lapt::lib_dir_list "$opt_dir/lib" "$opt_dir/lib" "$pkg")
        [[ $after_kind == *bin* ]] && bin_dir="$opt_dir/bin"
        printf '%s' "$wrap_manifest" | lapt::wrap_top_level_bins "$opt_dir" "$opt_dir" "$pkg" "$lib_dir" "$bin_dir"
      fi
    fi
  fi

  printf '%s\n' "${still_satisfied[@]}" | lapt::system_deps_write "$opt_dir"
  return 0
}

cmd_rewrap() {
  local pkg=$1
  local opt_dir="$LAPT_HOME/opt/$pkg"
  [[ -f "$opt_dir/.lapt/version" ]] || lapt::die "$pkg is not installed"

  local version
  version=$(sed -n 's/^version=//p' "$opt_dir/.lapt/version")

  # Recover which of opt_dir's current bin/ files are pkg's own -- same
  # trick cmd_fix uses (bin/lapt:220-263): a fresh bundle_manifest against
  # just pkg's own cache entry tags the rel paths that belong to it, since a
  # plain scan of opt_dir can't tell "pkg's own file" from "a dependency's
  # file" once they're on disk together.
  local own_manifest
  own_manifest=$(lapt::bundle_manifest "$(mktemp -u -d)" "$pkg"$'\t'"$version"$'\t'"$pkg") \
    || lapt::die "failed to recompute manifest for $pkg"

  local -A own_bin=()
  local rel src origin
  while IFS=$'\t' read -r rel src origin; do
    [[ $rel == bin/* ]] && own_bin[$rel]=1
  done <<<"$own_manifest"

  (( ${#own_bin[@]} > 0 )) || { echo "lapt: $pkg has no top-level bin/ files to wrap"; return 0; }

  # Scan opt_dir as it stands right now (no new specs -- rewrap never
  # fetches, that's fix's job) and re-tag pkg's own bin/ files' origin from
  # "existing" to $pkg, same re-tagging cmd_fix does, so needs_wrapper can
  # tell them apart from a dependency's bin/ files.
  local full_manifest
  full_manifest=$(lapt::bundle_manifest "$opt_dir") || lapt::die "failed to scan $opt_dir"

  local wrap_manifest=""
  while IFS=$'\t' read -r rel src origin; do
    # bin/<name>.real is a wrapper artifact from a prior wrap, not real
    # package content -- counting it as a foreign bin/ file would wrongly
    # force a PATH export on every refresh of an already-wrapped package.
    [[ $rel == *.real ]] && continue
    [[ $origin == existing && -n ${own_bin[$rel]+x} ]] && origin=$pkg
    wrap_manifest+="$rel"$'\t'"$src"$'\t'"$origin"$'\n'
  done <<<"$full_manifest"

  local wrapper_kind
  wrapper_kind=$(printf '%s' "$wrap_manifest" | lapt::needs_wrapper "$pkg")
  local lib_dir="" bin_dir=""
  [[ $wrapper_kind == *lib* ]] && lib_dir=$(lapt::lib_dir_list "$opt_dir/lib" "$opt_dir/lib" "$pkg")
  [[ $wrapper_kind == *bin* ]] && bin_dir="$opt_dir/bin"

  local already_wrapped=0
  for rel in "${!own_bin[@]}"; do
    [[ -e "$opt_dir/$rel.real" ]] && already_wrapped=1
  done

  if (( already_wrapped )); then
    # Refresh in place: write_wrapper only overwrites the wrapper script,
    # never touches .real, so it's safe to call again unconditionally.
    for rel in "${!own_bin[@]}"; do
      [[ -e "$opt_dir/$rel.real" ]] || continue
      lapt::write_wrapper "$opt_dir/$rel" "$opt_dir/$rel.real" "$lib_dir" "$bin_dir" "$pkg" "$opt_dir" "$opt_dir"
    done
    echo "lapt: refreshed $pkg's wrapper"
  elif [[ -n $wrapper_kind ]]; then
    printf '%s' "$wrap_manifest" | lapt::wrap_top_level_bins "$opt_dir" "$opt_dir" "$pkg" "$lib_dir" "$bin_dir"
    echo "lapt: wrapped $pkg"
  else
    echo "lapt: $pkg does not need a wrapper"
  fi
  return 0
}

cmd_vendor() {
  (( $# > 0 )) || lapt::die "usage: lapt vendor <pkg...>"

  local -a missing=()
  local pkg
  for pkg in "$@"; do
    [[ -f "$LAPT_HOME/opt/$pkg/.lapt/version" ]] || missing+=("$pkg")
  done
  (( ${#missing[@]} == 0 )) || lapt::die "not installed: ${missing[*]} — run 'lapt install' first"

  local opt_dir
  for pkg in "$@"; do
    opt_dir="$LAPT_HOME/opt/$pkg"
    printf 'export PATH="%s/bin:$PATH"\n' "$opt_dir"
    printf 'export LD_LIBRARY_PATH="%s/lib:$LD_LIBRARY_PATH"\n' "$opt_dir"
    printf 'export PKG_CONFIG_PATH="%s/lib/pkgconfig:$PKG_CONFIG_PATH"\n' "$opt_dir"
  done
  return 0
}

cmd_prune() {
  local cache_root="$LAPT_HOME/cache"
  local entry_dir
  for entry_dir in "$cache_root"/*/; do
    [[ -d $entry_dir ]] || continue
    lapt::cache_referenced "$entry_dir" && continue
    rm -rf "$entry_dir"
    echo "lapt: pruned $(basename "$entry_dir")"
  done
  return 0
}

cmd_init() {
  mkdir -p "$LAPT_HOME"
  cat > "$LAPT_HOME/env" <<'EOF'
# source this to put lapt on PATH/MANPATH: . env
_lapt_pathadd() {
  local -n __lapt_var=$2
  case ":$__lapt_var:" in
    *":$1:"*) ;;
    *) __lapt_var="$1:$__lapt_var${3:-}" ;;
  esac
  export "$2"
}
_lapt_pathadd "$HOME/.lapt/bin" PATH
_lapt_pathadd "$HOME/.lapt/share/man" MANPATH ":"
unset -f _lapt_pathadd
EOF

  echo "lapt: wrote $LAPT_HOME/env -- add this line to your ~/.bashrc:"
  echo '  . "$HOME/.lapt/env"'
  return 0
}

case "${1:-}" in
  ""|--help) usage; exit 0 ;;
  install) shift; cmd_install "$@" ;;
  expose) shift; cmd_expose "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  list) shift; cmd_list "$@" ;;
  fix) shift; cmd_fix "$@" ;;
  rewrap) shift; cmd_rewrap "$@" ;;
  vendor) shift; cmd_vendor "$@" ;;
  prune) shift; cmd_prune "$@" ;;
  init) shift; cmd_init "$@" ;;
  *) lapt::warn "unknown subcommand: $1"; usage >&2; exit 1 ;;
esac
